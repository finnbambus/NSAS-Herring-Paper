// ─── THEME ───────────────────────────────────────────────────────────
// Uses only common preinstalled/system fonts.

#let accent     = rgb(0, 51, 102)
#let accent-bg  = accent.lighten(78%)
#let text-muted = rgb(80, 80, 80)
#let text-faint = rgb(140, 140, 140)

// Font stacks: all names must be strings in Typst.
#let font-sans  = ("Arial", "Liberation Sans", "DejaVu Sans")
#let font-serif = ("Times New Roman", "Liberation Serif", "DejaVu Serif")
#let font-mono  = ("Courier New", "Liberation Mono", "DejaVu Sans Mono")